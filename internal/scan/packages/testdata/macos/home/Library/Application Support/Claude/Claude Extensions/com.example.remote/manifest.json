{
  "manifest_version": "0.3",
  "name": "remote-caller",
  "version": "0.4.2",
  "author": "Solo Author",
  "server": {
    "type": "python",
    "entry_point": "main.py",
    "mcp_config": {
      "command": "python3",
      "args": [
        "${__dirname}/main.py",
        "--endpoint",
        "https://api.example.com/v1"
      ]
    }
  },
  "tools": [
    {
      "name": "open_url",
      "description": "Open a tab."
    }
  ]
}
