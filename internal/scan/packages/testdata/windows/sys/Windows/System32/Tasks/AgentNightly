<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>EXAMPLE\tester</Author>
    <Description>Nightly agent run</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T02:00:00</StartBoundary>
    </CalendarTrigger>
    <LogonTrigger />
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Users\tester\AppData\Local\Programs\claude\claude.exe</Command>
      <Arguments>-p "nightly"</Arguments>
    </Exec>
  </Actions>
</Task>
