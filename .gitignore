# Build output. These are anchored with a leading slash on purpose: an
# unanchored "agentsurface" matches at every level, so it excluded the whole
# cmd/agentsurface/ directory and quietly kept baseline_test.go out of the
# repository. Git will not descend into an excluded directory, so no negation
# further down this file can rescue a file underneath one.
/bin/
/dist/
/agentsurface
/agentsurface.exe

# Go build and test artefacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof
coverage.out
coverage.html

# Go workspace files. A local go.work can silently change what is built, so it
# stays out of the repository.
go.work
go.work.sum

# Signing and release material. Nothing here should ever reach a commit.
*.pem
*.key
*.p12
*.pfx
cosign.key
cosign.password
checksums.txt
checksums.txt.sig
checksums.txt.pem
*.sbom.json
*.spdx.json

# Editors and tooling
.idea/
.vscode/
*.swp
*.swo
*~
.env
.envrc
.direnv/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini

# Linux
.fuse_hidden*
.Trash-*

# Scratch space that is useful locally and never wanted in the tree
/scratch/
/tmp/

# Test fixtures are data, not editor droppings. Without these negations the
# rules above silently swallow project-scope fixtures (.vscode/mcp.json was
# lost this way, and CI failed on every platform with "found 4 servers,
# want 5" while the tests passed locally).
!**/testdata/**
